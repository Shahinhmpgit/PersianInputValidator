 <Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>PersianInputValidator</PackageId>
    <Version>0.1.2</Version>
    <Authors>Shahinhmpgit</Authors>
    <Description>A lightweight .NET library for Persian and Arabic-Indic digit normalization, Iranian input validation, and Persian text processing.</Description>
    <PackageTags>persian;farsi;persian-validation;persian-digits;iranian-validation;iranian-mobile;iranian-national-code;iranian-postal-code;unicode;normalization;dotnet;csharp;validation;input-validation;text-processing</PackageTags>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Shahinhmpgit/PersianInputValidator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahinhmpgit/PersianInputValidator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright 2026 Shahinhmpgit</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
